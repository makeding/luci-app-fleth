#!/bin/ash
# ipip6hp firewall rule maintenance on interface changes

[ -f /usr/share/fleth/ipip6hp-hotplug.sh ] && . /usr/share/fleth/ipip6hp-hotplug.sh

if [ "$ACTION" = "ifup" ] || [ "$ACTION" = "ifdown" ]; then
    proto=$(uci get network.${INTERFACE}.proto 2>/dev/null)
fi

# Re-apply ipip6hp passthrough rules after interface up and persist them for fw4 reloads.
if [ "$ACTION" = "ifup" ] && [ "$proto" = "ipip6hp" ]; then
    (
        sleep 1
        type fleth_apply_ipip6hp_rules >/dev/null 2>&1 && fleth_apply_ipip6hp_rules "$INTERFACE"
    ) &
fi

if [ "$ACTION" = "ifdown" ] && [ "$proto" = "ipip6hp" ]; then
    type fleth_remove_ipip6hp_rules >/dev/null 2>&1 && fleth_remove_ipip6hp_rules "$INTERFACE"
fi

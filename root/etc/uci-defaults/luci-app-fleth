#!/bin/sh

for file in \
    /usr/sbin/fleth \
    /lib/netifd/proto/fleth.sh \
    /lib/netifd/proto/ipip6h.sh \
    /lib/netifd/proto/ipip6hp.sh \
    /usr/share/fleth/firewall.include \
    /usr/share/fleth/common.sh \
    /usr/share/fleth/ipip6h-common.sh \
    /usr/share/fleth/ipip6hp-hotplug.sh; do
    [ -f "$file" ] && chmod +x "$file"
done

if [ -d /usr/share/luci/menu.d ]; then
    rm -f /usr/lib/lua/luci/controller/fleth.lua
    rm -f /usr/lib/lua/luci/model/cbi/fleth.lua
fi

rm -f /etc/config/fleth

if [ -f /usr/share/fleth/firewall.include ] && ! uci -q get firewall.fleth_ipip6hp >/dev/null; then
    uci set firewall.fleth_ipip6hp='include'
    uci set firewall.fleth_ipip6hp.enabled='1'
    uci set firewall.fleth_ipip6hp.type='script'
    uci set firewall.fleth_ipip6hp.path='/usr/share/fleth/firewall.include'
    uci set firewall.fleth_ipip6hp.fw4_compatible='1'
    uci commit firewall
fi
exit 0
